# Pro-Harp Emergency Response System - Production Environment
# Copy this to .env and fill in real values

# --- Twilio (SMS & Voice) ---
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# --- Firebase Cloud Messaging (Push Notifications) ---
FIREBASE_PROJECT_ID=proharp-prod
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# --- Slack/Teams Webhooks ---
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
TEAMS_WEBHOOK_URL=your_teams_webhook_url_here

# --- Azure Sentinel ---
SENTINEL_WORKSPACE_ID=your_workspace_id_here
# Workspace key should stay in Key Vault, but can be provided here for local testing
SENTINEL_WORKSPACE_KEY=your_workspace_key_here

# --- Entity Management ---
COSMOS_DB_CONNECTION_STRING=your_cosmos_db_connection_string_here
TENANT_ID=tenant-city-one

# --- Azure AD Authentication (Dashboard) ---
AZURE_TENANT_ID=your_azure_tenant_id_here
AZURE_CLIENT_ID=your_azure_client_id_here
AZURE_CLIENT_SECRET=your_client_secret_here
REDIRECT_URI=http://localhost:8501
